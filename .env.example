# Copiar a .env (en esta misma carpeta, la raíz del repo) y completar.
# Las marcadas con (*) son obligatorias: sin ellas el server no arranca.

# --- Servidor ---
PORT=3000
NODE_ENV=development
# URL del cliente: CORS y links de los mails
CLIENT_URL=http://localhost:5173
# Con "false" esta instancia no corre los vencimientos automáticos (útil con varias instancias)
TAREAS_PERIODICAS=true

# --- Base de datos ---
# (*) MongoDB con replica set (las transacciones lo requieren; Atlas ya lo es)
MONGO_URI=

# --- Sesión ---
# (*) Secreto para firmar los JWT: 32 caracteres o más
JWT_SECRET=
JWT_EXPIRES_IN=7d
INVITE_TOKEN_EXPIRES_HOURS=48
COTIZACION_EXPIRA_HORAS=72

# --- Admin inicial (seeds/adminSeed.js) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Mails ---
# Con cualquier valor distinto de "true" no se envía ningún mail
ENABLE_EMAIL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# --- Asistente inteligente (Google Gemini) ---
# Sin clave, el asistente responde en modo básico
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=10000

# --- Mercado Pago (credenciales de PRUEBA) ---
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_APP_ID=
MP_USER_ID=
MP_TIPO_CAMBIO_ARS=1450
MP_WEBHOOK_URL=
# Clave secreta del panel de Webhooks: sin ella no se valida la firma
MP_WEBHOOK_SECRET=
# Usuario vendedor de prueba (solo para entrar al panel de MP)
MP_TEST_VENDEDOR_USUARIO=
MP_TEST_VENDEDOR_PASSWORD=
MP_TEST_VENDEDOR_CODIGO_VERIFICACION=
